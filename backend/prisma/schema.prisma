// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String?
  lastName  String?
  email     String   @unique
  password  String   @default("")
  phone     String?
  role      String   @default("user") // "admin" | "user" | "parent" | "staff"
  staffRole String?  // e.g. "Teacher", "Librarian", "Bus Driver"
  rfidTag         String?   @unique
  isVerified      Boolean   @default(true) // Admins are true by default, Parents will be false until they set password
  registrationOtp String?
  otpExpiry       DateTime?
  resetPasswordOtp String?
  resetPasswordExpiry DateTime?
  // ── Secure Parent Activation ──────────────────────────────────────────────
  activationToken  String?   @unique
  activationExpiry DateTime?
  isFirstLogin     Boolean   @default(true)
  trustedDevice    String?
  // ─────────────────────────────────────────────────────────────────────────
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  student       Student?  @relation("ParentStudent")
  adminStudents    Student[]    @relation("AdminStudents")
  adminAttendances Attendance[] @relation("AdminAttendances")
  adminBuses       Bus[]        @relation("AdminBuses")
  sessions         Session[]
  
  schoolId  Int?      @unique
  school    School?   @relation(fields: [schoolId], references: [id])
}

model School {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  admin           User?
  rolePermissions RolePermission[]
}

model Student {
  id              Int      @id @default(autoincrement())
  studentId       String?  @unique
  fullName        String   @map("name")
  rollNumber      String   @unique
  className       String   @map("class")
  section         String?
  gender          String?
  guardianName    String?
  email           String?  @unique @map("parentEmail")
  phoneNumber     String?  @map("parentPhone")
  rfidTag         String?  @unique
  rfid_uid        String?  @unique @db.VarChar(50)
  profileImage    String?  @map("photoUrl")
  isActive        Boolean  @default(true)
  status          String   @default("active")
  joinedDate      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  adminId         Int?
  admin           User?    @relation("AdminStudents", fields: [adminId], references: [id])

  userId          Int?     @unique
  user            User?    @relation("ParentStudent", fields: [userId], references: [id])

  attendances     Attendance[]
  boardingLogs    BoardingLog[]
  libraryLogs     LibraryLog[]
  libraryIssues   LibraryIssue[]
  payments        Payment[]
  feeTransactions    FeeTransaction[]
  rfidWallet         RFIDWallet?
  walletTransactions WalletTransaction[]
  activities         StudentActivity[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  status      String   @default("present") // "present" | "absent" | "late" | "half-day"
  checkIn     DateTime?
  checkOut    DateTime?
  rfidEnabled Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  adminId     Int?
  admin       User?    @relation("AdminAttendances", fields: [adminId], references: [id])

  activities  AttendanceActivity[]
}

model AttendanceActivity {
  id           Int      @id @default(autoincrement())
  attendanceId Int
  action       String
  description  String
  createdAt    DateTime @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

model Bus {
  id               Int           @id @default(autoincrement())
  busNumber        String        @unique
  driverName       String
  routeName        String
  currentLatitude  Float?
  currentLongitude Float?
  status           String        @default("On Route") // "On Route" | "Arrived" | "Delayed" | "Maintenance" | "Offline"
  
  adminId          Int
  admin            User          @relation("AdminBuses", fields: [adminId], references: [id])
  
  boardingLogs     BoardingLog[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
}

model BoardingLog {
  id           Int      @id @default(autoincrement())
  boardedAt    DateTime @default(now())
  locationName String
  status       String   @default("Boarded")

  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  busId        Int
  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

model LibraryLog {
  id         Int      @id @default(autoincrement())
  bookTitle  String
  bookId     String?
  action     String   // "borrowed" | "returned"
  borrowedAt DateTime @default(now())
  dueDate    DateTime?
  returnedAt DateTime?
  fine       Float    @default(0)

  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id          Int      @id @default(autoincrement())
  amount      Float
  type        String   // "tuition" | "bus" | "library" | "other"
  description String?
  status      String   @default("pending") // "pending" | "paid" | "overdue"
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model StudentActivity {
  id          Int      @id @default(autoincrement())
  studentId   Int
  action      String
  description String
  createdAt   DateTime @default(now())

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Book {
  id              String   @id @default(cuid())
  title           String
  bookCode        String   @unique
  totalCopies     Int
  availableCopies Int
  createdAt       DateTime @default(now())

  issues LibraryIssue[]
}

model LibraryIssue {
  id         String   @id @default(cuid())
  studentId  Int
  bookId     String
  status     String
  issueDate  DateTime
  dueDate    DateTime
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id])
}

model FeeTransaction {
  id          String   @id @default(cuid())
  studentId   Int
  description String
  amount      Float
  status      String
  paymentType String
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model RFIDWallet {
  id        String   @id @default(cuid())
  studentId Int      @unique
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String   @id @default(cuid())
  studentId   Int
  amount      Float
  type        String   // CREDIT or DEBIT
  source      String   // RECHARGE / BUS / CANTEEN / LIBRARY
  description String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  senderRole String   // "parent" | "teacher" | "admin"
  receiverId Int?     // Can be null if sent to admin
  chatType   String   // "teacher_chat" | "admin_chat"
  message    String   @db.Text
  isSeen     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  role          String   // "parent" | "teacher" | "admin"
  title         String
  message       String
  isRead        Boolean  @default(false)
  relatedChatId Int?
  createdAt     DateTime @default(now())
}

// ── Meeting / Google Meet Models ─────────────────────────────────────────────

model Meeting {
  id            Int      @id @default(autoincrement())
  meetingUuid   String   @unique
  title         String
  description   String?  @db.Text
  googleMeetUrl String
  googleEventId String?
  createdById   Int
  creatorRole   String   // "admin" | "teacher"
  scheduledAt   DateTime
  durationMins  Int      @default(60)
  status        String   @default("scheduled") // "scheduled" | "cancelled" | "completed"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  MeetingParticipant[]
}

model MeetingParticipant {
  id           Int      @id @default(autoincrement())
  meetingId    Int
  userId       Int?
  email        String
  name         String?
  role         String   // "parent" | "teacher" | "admin"
  inviteStatus String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt    DateTime @default(now())

  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model GoogleToken {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RolePermission {
  id                  Int      @id @default(autoincrement())
  roleName            String   @unique
  canAccessDashboard  Boolean  @default(true)
  canAccessLibrary    Boolean  @default(false)
  canAccessPayments   Boolean  @default(false)
  canAccessStudents   Boolean  @default(false)
  canAccessAttendance Boolean  @default(false)
  canAccessBus        Boolean  @default(false)
  
  schoolId            Int?
  school              School?  @relation(fields: [schoolId], references: [id])
}

// ── AI Parent Assistant Models ───────────────────────────────────────────────

model AIChatMessage {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  role      String   // "user" | "assistant"
  message   String   @db.Text
  createdAt DateTime @default(now())

  // We could add relations to User and Student if needed, but keeping it simple as requested
}

model AIEscalation {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  issue     String   @db.Text
  status    String   @default("pending") // "pending" | "resolved"
  createdAt DateTime @default(now())
}

