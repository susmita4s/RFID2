// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String?
  lastName  String?
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("user") // "admin" | "user" | "parent"
  rfidTag         String?   @unique
  isVerified      Boolean   @default(true) // Admins are true by default, Parents will be false initially
  registrationOtp String?
  otpExpiry       DateTime?
  resetPasswordOtp String?
  resetPasswordExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  student       Student?  @relation("ParentStudent")
  adminStudents    Student[]    @relation("AdminStudents")
  adminAttendances Attendance[] @relation("AdminAttendances")
  adminBuses       Bus[]        @relation("AdminBuses")
  sessions         Session[]
  
  schoolId  Int?      @unique
  school    School?   @relation(fields: [schoolId], references: [id])
}

model School {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  admin     User?
}

model Student {
  id              Int      @id @default(autoincrement())
  studentId       String?  @unique
  fullName        String   @map("name")
  rollNumber      String   @unique
  className       String   @map("class")
  section         String?
  gender          String?
  guardianName    String?
  email           String?  @unique @map("parentEmail")
  phoneNumber     String?  @map("parentPhone")
  rfidTag         String?  @unique
  profileImage    String?  @map("photoUrl")
  isActive        Boolean  @default(true)
  status          String   @default("active")
  joinedDate      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  adminId         Int?
  admin           User?    @relation("AdminStudents", fields: [adminId], references: [id])

  userId          Int?     @unique
  user            User?    @relation("ParentStudent", fields: [userId], references: [id])

  attendances     Attendance[]
  boardingLogs    BoardingLog[]
  libraryLogs     LibraryLog[]
  payments        Payment[]
  activities      StudentActivity[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  status      String   @default("present") // "present" | "absent" | "late" | "half-day"
  checkIn     DateTime?
  checkOut    DateTime?
  rfidEnabled Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])

  adminId     Int?
  admin       User?    @relation("AdminAttendances", fields: [adminId], references: [id])

  activities  AttendanceActivity[]
}

model AttendanceActivity {
  id           Int      @id @default(autoincrement())
  attendanceId Int
  action       String
  description  String
  createdAt    DateTime @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

model Bus {
  id               Int           @id @default(autoincrement())
  busNumber        String        @unique
  driverName       String
  routeName        String
  currentLatitude  Float?
  currentLongitude Float?
  status           String        @default("On Route") // "On Route" | "Arrived" | "Delayed" | "Maintenance" | "Offline"
  
  adminId          Int
  admin            User          @relation("AdminBuses", fields: [adminId], references: [id])
  
  boardingLogs     BoardingLog[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
}

model BoardingLog {
  id           Int      @id @default(autoincrement())
  boardedAt    DateTime @default(now())
  locationName String
  status       String   @default("Boarded")

  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  busId        Int
  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

model LibraryLog {
  id         Int      @id @default(autoincrement())
  bookTitle  String
  bookId     String?
  action     String   // "borrowed" | "returned"
  borrowedAt DateTime @default(now())
  dueDate    DateTime?
  returnedAt DateTime?
  fine       Float    @default(0)

  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
}

model Payment {
  id          Int      @id @default(autoincrement())
  amount      Float
  type        String   // "tuition" | "bus" | "library" | "other"
  description String?
  status      String   @default("pending") // "pending" | "paid" | "overdue"
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model StudentActivity {
  id          Int      @id @default(autoincrement())
  studentId   Int
  action      String
  description String
  createdAt   DateTime @default(now())

  student     Student @relation(fields: [studentId], references: [id])
}
